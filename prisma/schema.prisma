generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  order    Int       @default(0)
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  priceCents  Int
  imageUrl    String      @default("/images/products/cookie-pepites-chocolat.jpg")
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Store {
  id         String @id @default(cuid())
  name       String
  address    String
  city       String
  postalCode String
  phone      String
  hours      String
  imageUrl   String @default("/images/boutique.jpg")
  order      Int    @default(0)
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  PRETE
  LIVREE
  ANNULEE
}

enum DeliveryMethod {
  RETRAIT_BOUTIQUE
  LIVRAISON
}

model Order {
  id             String         @id @default(cuid())
  customerName   String
  email          String
  phone          String
  address        String?
  city           String?
  postalCode     String?
  deliveryMethod DeliveryMethod @default(RETRAIT_BOUTIQUE)
  status         OrderStatus    @default(EN_ATTENTE)
  totalCents     Int
  notes          String?
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitCents   Int
  quantity    Int
}
